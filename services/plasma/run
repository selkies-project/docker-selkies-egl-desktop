#!/bin/bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
export DISPLAY="${DISPLAY:-:20}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ubuntu}"
until [ -f "${XDG_RUNTIME_DIR}/container-env" ]; do sleep 0.5; done
# shellcheck disable=SC1091  # written by container-entrypoint.sh at startup
. "${XDG_RUNTIME_DIR}/container-env"

# The Plasma X11 session, or kwin alone, on the base's framebuffer server. On
# the Wayland backend the whole session runs under the wayland service instead
# (selkies-kwin: Plasma starts its own compositor there), so this service
# parks rather than exiting into an s6 restart loop.
if [ "${SELKIES_WAYLAND:-false}" = "true" ]; then
  echo "[plasma] Wayland backend active; the session runs under the wayland service"
  exec sleep infinity
fi
start_plasma="${START_PLASMA%%|*}"
start_plasma="${start_plasma,,}"
start_plasma="${start_plasma// /}"

until [ -S "/tmp/.X11-unix/X${DISPLAY#*:}" ]; do sleep 0.5; done

# The bus the dbus-session service serves (see selkies-kwin for why it is a
# fixed address); startplasma refuses to run without one.
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/selkies-session-bus"
until [ -S "${XDG_RUNTIME_DIR}/selkies-session-bus" ]; do sleep 0.5; done

# Only the window manager: windows are managed, resized and maximized for a
# single application streamed without a desktop, the same as the Wayland
# backend's kwin-only mode. kwin_x11 reads the session type it is started
# under and the image's kwinrc, and registers on the session bus above.
export XDG_SESSION_TYPE="x11"
if [ -n "${start_plasma}" ] && [ "${start_plasma}" != "true" ] && [ "${start_plasma}" != "1" ]; then
  echo "[plasma] START_PLASMA=${START_PLASMA}: running kwin_x11 without the Plasma shell on ${DISPLAY}"
  exec kwin_x11
fi

# startplasma-x11 sets the session's own identity (XDG_CURRENT_DESKTOP,
# KDE_SESSION_VERSION, DESKTOP_SESSION) and runs plasma_session, which starts
# kwin_x11 and the shell; kwin_x11 takes its screens from the RandR monitors
# Selkies publishes (patches/kwin-x11/), so a second display is a screen of
# its own.
echo "[plasma] session draws on ${DISPLAY}"
exec startplasma-x11
